<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_bg">

    <LinearLayout
        android:id="@+id/difficulty_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/panel_difficulty"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:id="@+id/difficulty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/difficulty_title"
            android:textAlignment="center"
            android:textColor="@color/menu_text"
            android:textSize="22sp"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/difficulty_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/banner_warning"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="@string/difficulty_warning"
            android:textAlignment="center"
            android:textColor="@color/menu_text"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/difficulty_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/log_item_bg"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp">

            <RadioGroup
                android:id="@+id/difficulty_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/difficulty_beginner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/menu_text"
                    android:paddingVertical="8dp"
                    android:textStyle="bold"
                    android:text="@string/difficulty_beginner"
                    android:textColor="@color/menu_text" />

                <RadioButton
                    android:id="@+id/difficulty_easy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/menu_text"
                    android:paddingVertical="8dp"
                    android:textStyle="bold"
                    android:text="@string/difficulty_easy"
                    android:textColor="@color/menu_text" />

                <RadioButton
                    android:id="@+id/difficulty_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/menu_text"
                    android:paddingVertical="8dp"
                    android:textStyle="bold"
                    android:text="@string/difficulty_medium"
                    android:textColor="@color/menu_text" />

                <RadioButton
                    android:id="@+id/difficulty_hard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/menu_text"
                    android:paddingVertical="8dp"
                    android:textStyle="bold"
                    android:text="@string/difficulty_hard"
                    android:textColor="@color/menu_text" />

                <RadioButton
                    android:id="@+id/difficulty_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/menu_text"
                    android:paddingVertical="8dp"
                    android:textStyle="bold"
                    android:text="@string/difficulty_export"
                    android:textColor="@color/menu_text" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/menu_stroke" />

            <TextView
                android:id="@+id/difficulty_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/menu_text"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/done_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/chip_bg_state"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:text="@string/difficulty_done"
            android:textAllCaps="false"
            android:textColor="@color/chip_text" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
